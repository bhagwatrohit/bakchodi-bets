# Local development — Postgres in Docker (docker compose up -d)
DATABASE_URL=postgres://bakchodi:bakchodi@localhost:5432/bakchodi
# 32+ char random string for signing session JWTs (generate your own)
AUTH_SECRET=replace-with-a-long-random-string-min-32-chars
NODE_ENV=development

# --- Lakebase (future) ---
# Point DATABASE_URL at your Lakebase Postgres endpoint and supply a short-lived
# OAuth token as the password. See lib/db/lakebase-credential.ts.
